{
  "info": {
    "_postman_id": "b8b9e5be-1f12-4f6c-a632-7e75f56a2e11",
    "name": "Prueba Tecnica - Reversion Transacciones",
    "description": "Coleccion para probar los casos de reversion sobre http://localhost:8080 usando la base SQLite de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1 - Reversion valida - 204",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transacciones/1/reversar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transacciones",
            "1",
            "reversar"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 204', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2 - Estado invalido - 409",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transacciones/2/reversar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transacciones",
            "2",
            "reversar"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 409', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test('Mensaje de estado invalido', function () {",
              "    pm.expect(pm.response.text()).to.include('solo se pueden reversar APROBADAS');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
